exports[`Inicio — interruptor APAGADO = la pantalla de hoy > secretaria: HTML idéntico al de origin/main 1`] = `"<div class="min-h-screen bg-white"><div data-testid="encabezado"></div><div class="max-w-6xl mx-auto px-4 sm:px-6 py-6"><div class="flex items-start justify-between gap-4 mb-6"><div class="min-w-0"><h1 class="font-display text-2xl sm:text-3xl font-medium tracking-tight  truncate text-gray-950">Buen día, Angela</h1><p class="text-sm mt-0.5 text-gray-500">9 oct 2026</p></div><div class="hidden sm:block"><div class="relative flex-shrink-0" data-menu-usuario="true"><button type="button" aria-haspopup="menu" aria-expanded="false" class="flex min-h-[44px] items-center gap-2 rounded-full pl-1 pr-2 text-sm text-gray-700 transition hover:bg-gray-50"><span class="flex h-8 w-8 items-center justify-center rounded-full bg-gray-100 text-xs font-medium uppercase text-gray-600">A</span><span class="font-medium capitalize">Angela</span></button></div></div><button type="button" data-avatar-usuario="true" aria-label="Tu cuenta: Angela" aria-haspopup="dialog" aria-expanded="false" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full transition active:scale-[0.97] sm:hidden "><span aria-hidden="true" class="flex h-9 w-9 items-center justify-center rounded-full bg-gray-200 text-[15px] font-semibold text-gray-700">A</span></button></div><div data-testid="buscador"></div><div class="space-y-6"><section><h2 class="text-xs font-semibold uppercase tracking-wide mb-2 px-1 text-gray-500">Ventas y clientes</h2><div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-2 sm:gap-3"><a class="group flex rounded-lg border transition-all duration-150 active:scale-[0.97] border-gray-200 bg-gray-50 hover:border-gray-400 hover:bg-white hover:shadow-sm min-h-[78px] flex-col items-center justify-center gap-2 px-2 py-3 text-center" href="/comisiones"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="curre