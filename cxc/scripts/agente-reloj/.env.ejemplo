# ─────────────────────────────────────────────────────────────────────────────
# Configuración del agente del reloj.
#
# CÓMO SE USA: copia este archivo con el nombre  .env  (así, empezando con
# punto y sin nada más) EN ESTA MISMA CARPETA, y llena los cuatro datos de
# abajo. El archivo .env NUNCA se sube a git — tiene contraseñas.
# ─────────────────────────────────────────────────────────────────────────────

# ── RELOJ 1 — EL DE CONFECCIONES BOSTON ──────────────────────────────────────
# La dirección que se le puso en la red de la oficina.
RELOJ_HOST=192.168.10.10

# El usuario y la contraseña del reloj (los mismos del iVMS-4200).
RELOJ_USUARIO=admin
RELOJ_CLAVE=PONER-LA-CLAVE-AQUI

# ── RELOJ 2 — EL DE MULTIFASHION ─────────────────────────────────────────────
# Se ve desde esta misma PC por el túnel WireGuard. En el iVMS-4200 aparece
# como "Reloj Amercan Classics".
#
# Son DOS renglones y nada más: el usuario y la contraseña se toman del reloj 1
# si no se escriben acá, porque hoy son los mismos en los dos aparatos.
#
# ⚠️ Si un día le cambian la contraseña a UNO solo, se agregan estos dos:
#     RELOJ_2_USUARIO=admin
#     RELOJ_2_CLAVE=LA-OTRA-CLAVE
RELOJ_2_HOST=192.168.20.98
RELOJ_2_DISPOSITIVO=reloj acs

# Se pueden agregar más relojes con RELOJ_3_HOST / RELOJ_3_DISPOSITIVO, y así
# hasta el 9. Cada uno TIENE que llevar su propio nombre en _DISPOSITIVO: es lo
# que evita que las marcaciones de un reloj tapen las del otro.

# ── FASHIONGR ────────────────────────────────────────────────────────────────
# La llave para poder mandar las marcaciones. Es la variable
# ASISTENCIA_INGEST_SECRET que está configurada en Vercel: se copia igual.
FASHIONGR_SECRET=PONER-LA-LLAVE-AQUI

# Normalmente no hace falta tocar esto. Va CON "www": sin él la página redirige
# y en el camino se pierde la llave (sale "No autorizado" aunque esté bien).
FASHIONGR_URL=https://www.fashiongr.com

# ── AJUSTES (opcionales) ─────────────────────────────────────────────────────
# El nombre del RELOJ 1. ⚠️ NO CAMBIAR sin avisar: es el nombre con el que ya
# están guardadas las marcaciones; si cambia, se volverían a guardar todas de
# nuevo y las horas trabajadas saldrían al doble.
DISPOSITIVO=reloj cboston

# Cada cuántos minutos le pregunta al reloj. Con 3 minutos, el botón
# "Traer ahora" de la pantalla se siente inmediato.
VUELTA_MINUTOS=3

# Cuántos días para atrás pregunta cada vez. Con 3 se rellena solo cualquier
# hueco de un fin de semana con la PC apagada.
#
# Para traer historia vieja de una sola vez (por ejemplo, todo el mes pasado):
# pon aquí 45, deja que dé una vuelta, y vuélvelo a poner en 3.
VENTANA_DIAS=3

# Cuántos días pide cuando SE DA CUENTA de que le falta algo (por ejemplo, la
# PC estuvo apagada una semana). Eso lo hace solo: no hay que tocar nada.
#
# ⚠️ No subir VENTANA_DIAS a 15 para "cubrirse". El reloj entrega los eventos
# de 10 en 10, así que 15 días son ~125 preguntas por vuelta; preguntar eso cada
# 3 minutos castiga al aparato para siempre. Por eso son dos números distintos:
# el de siempre es corto, y el largo se usa solo cuando de verdad falta algo.
VENTANA_RECUPERACION_DIAS=15

# Fecha (AAAA-MM-DD) antes de la cual no se pregunta nunca. Déjalo vacío si no
# hace falta.
DESDE_FECHA=
