# ─────────────────────────────────────────────────────────────────────────────
# Configuración del agente del reloj.
#
# CÓMO SE USA: copia este archivo con el nombre  .env  (así, empezando con
# punto y sin nada más) EN ESTA MISMA CARPETA, y llena los cuatro datos de
# abajo. El archivo .env NUNCA se sube a git — tiene contraseñas.
# ─────────────────────────────────────────────────────────────────────────────

# ── EL RELOJ DE LA ENTRADA ───────────────────────────────────────────────────
# La dirección que se le puso en la red de la oficina.
RELOJ_HOST=192.168.10.10

# El usuario y la contraseña del reloj (los mismos del iVMS-4200).
RELOJ_USUARIO=admin
RELOJ_CLAVE=PONER-LA-CLAVE-AQUI

# ── FASHIONGR ────────────────────────────────────────────────────────────────
# La llave para poder mandar las marcaciones. Es la variable
# ASISTENCIA_INGEST_SECRET que está configurada en Vercel: se copia igual.
FASHIONGR_SECRET=PONER-LA-LLAVE-AQUI

# Normalmente no hace falta tocar esto.
FASHIONGR_URL=https://fashiongr.com

# ── AJUSTES (opcionales) ─────────────────────────────────────────────────────
# ⚠️ NO CAMBIAR sin avisar. Es el nombre con el que ya están guardadas las
# marcaciones; si cambia, se volverían a guardar todas de nuevo y las horas
# trabajadas saldrían al doble.
DISPOSITIVO=reloj cboston

# Cada cuántos minutos le pregunta al reloj. Con 3 minutos, el botón
# "Traer ahora" de la pantalla se siente inmediato.
VUELTA_MINUTOS=3

# Cuántos días para atrás pregunta cada vez. Con 3 se rellena solo cualquier
# hueco de un fin de semana con la PC apagada.
#
# Para traer historia vieja de una sola vez (por ejemplo, todo el mes pasado):
# pon aquí 45, deja que dé una vuelta, y vuélvelo a poner en 3.
VENTANA_DIAS=3

# Fecha (AAAA-MM-DD) antes de la cual no se pregunta nunca. Déjalo vacío si no
# hace falta.
DESDE_FECHA=
