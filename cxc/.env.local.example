NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
ADMIN_PASSWORD=your-admin-password
DIRECTOR_PASSWORD=your-director-password
DAVID_PASSWORD=your-david-password
UPLOAD_PASSWORD=your-upload-password
# Secreto para firmar la cookie de sesión (HMAC-SHA256). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# OBLIGATORIO en todos los entornos (Vercel Production + Preview). Sin esto el
# login no firma y la verificación falla (fail-closed) → nadie puede entrar.
SESSION_SECRET=your-session-secret

# ── Telegram ──────────────────────────────────────────────────────────────────
# Canal de SIEMPRE. Es el destino por defecto y la red de rescate: cualquier
# canal sin override configurado (o cuyo envío falle) termina acá.
TELEGRAM_BOT_TOKEN=123456:your-bot-token
TELEGRAM_CHAT_ID=your-chat-id
#
# Override POR CANAL, simétrico y todo OPCIONAL. Van EN PAREJA: un chat_id no
# significa nada sin su bot — cada bot ve su propio universo de chats, y en un
# chat privado el número es el id del USUARIO, el mismo para todos los bots.
#   - las dos puestas  → bot propio + chat propio
#   - solo el CHAT_ID  → el bot de siempre en otro chat/grupo
#   - solo el TOKEN    → se ignora (un bot sin chat no puede mandar nada)
#   - ninguna          → ese canal usa el de siempre
#
# Hoy (27-jul-2026): el bot NUEVO @fashiongr_sistema_bot lleva el NEGOCIO
# (ventas, pedidos, guías) y las alertas de SISTEMA se quedan en el bot de
# siempre. El nombre del bot dice "sistema" y lleva negocio: es a propósito.
TELEGRAM_BOT_TOKEN_NEGOCIO=
TELEGRAM_CHAT_ID_NEGOCIO=
TELEGRAM_BOT_TOKEN_SISTEMA=
TELEGRAM_CHAT_ID_SISTEMA=
