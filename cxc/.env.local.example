NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
ADMIN_PASSWORD=your-admin-password
DIRECTOR_PASSWORD=your-director-password
DAVID_PASSWORD=your-david-password
UPLOAD_PASSWORD=your-upload-password
# Secreto para firmar la cookie de sesión (HMAC-SHA256). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# OBLIGATORIO en todos los entornos (Vercel Production + Preview). Sin esto el
# login no firma y la verificación falla (fail-closed) → nadie puede entrar.
SESSION_SECRET=your-session-secret

# ── Telegram ──────────────────────────────────────────────────────────────────
# Canal de siempre (info del negocio: ventas, pedidos, guías, cheques).
TELEGRAM_BOT_TOKEN=123456:your-bot-token
TELEGRAM_CHAT_ID=your-chat-id
# Canal APARTE para las alertas de sistema (algo está roto). OPCIONALES:
# si faltan, las alertas de sistema van al canal de siempre — un olvido nunca
# deja a nadie sin enterarse. Van LAS DOS JUNTAS: un chat_id no significa nada
# sin su bot (cada bot ve su propio universo de chats).
#   - las dos puestas  → bot propio + chat propio
#   - solo el CHAT_ID  → el bot de siempre en otro grupo
#   - solo el TOKEN    → se ignora (un bot sin chat no puede mandar nada)
TELEGRAM_BOT_TOKEN_SISTEMA=
TELEGRAM_CHAT_ID_SISTEMA=
